# --- Environment-specific config (applied separately per environment) ---
wp-config.php

# --- WordPress runtime / generated files ---
# Media + theme/plugin caches are per-environment (min.css etc. embed the local host)
wp-content/uploads/
wp-content/debug.log
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/wp-cache-config.php
.htaccess

# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.log
*.swp
.idea/
.vscode/

# --- Files cPanel / the host writes into the document root (keep server tree clean) ---
error_log
.well-known/
.user.ini
php.ini
cgi-bin/

# --- ftp-sync tool (.ftp-sync/): credentials, sync snapshot and deps stay local ---
.ftp-sync/config.json
.ftp-sync/state.json
.ftp-sync/node_modules/
