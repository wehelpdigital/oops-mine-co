{
  "name": "oopsmine-ftp-sync",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server + CLI that mirrors this WordPress project to the live host over FTPS/FTP/SFTP",
  "type": "module",
  "bin": { "ftp-sync": "./server.mjs" },
  "scripts": {
    "status": "node server.mjs status",
    "sync": "node server.mjs sync",
    "watch": "node server.mjs watch"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "basic-ftp": "^5.0.5",
    "ssh2-sftp-client": "^11.0.0",
    "zod": "^3.23.8"
  }
}
